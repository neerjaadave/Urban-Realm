  // find nearest text
});

// Use text elements as triggers too
document.querySelectorAll('#map-wrap svg text').forEach(t=>{
  const city=t.textContent.trim();
  if(!cityData[city]) return;
  t.style.cursor='pointer';
  t.addEventListener('mouseenter',e=>showTT(e,city));
  t.addEventListener('mousemove',e=>moveTT(e));
  t.addEventListener('mouseleave',()=>tt.style.display='none');
});

document.querySelectorAll('#map-wrap svg circle').forEach(c=>{
  // Match by proximity to text
  const cx=parseFloat(c.getAttribute('cx'));
  const cy=parseFloat(c.getAttribute('cy'));
  // find matching city by nearest text
  let closest=null,minD=999;
  document.querySelectorAll('#map-wrap svg text').forEach(t=>{
    const tx=parseFloat(t.getAttribute('x'));
    const ty=parseFloat(t.getAttribute('y'));
    const d=Math.hypot(cx-tx,cy-ty);
    if(d<minD&&cityData[t.textContent.trim()]){minD=d;closest=t.textContent.trim();}
  });
  if(closest&&minD<30){
    c.style.cursor='pointer';
    c.addEventListener('mouseenter',e=>showTT(e,closest));
    c.addEventListener('mousemove',e=>moveTT(e));
    c.addEventListener('mouseleave',()=>tt.style.display='none');
  }
});

function showTT(e,city){
  const d=cityData[city];
  if(!d) return;
  document.getElementById('mtt-city').textContent=city;
  document.getElementById('mtt-country').textContent=d.country;
  document.getElementById('mtt-bar').style.width=d.score+'%';
  document.getElementById('mtt-score').textContent='Urban focus score: '+d.score+'%';
  tt.style.display='block';
  moveTT(e);
}
function moveTT(e){
  const wr=wrap.getBoundingClientRect();
  let x=e.clientX-wr.left+14,y=e.clientY-wr.top-14;
  if(x+170>wr.width) x-=190;
  tt.style.left=x+'px';
  tt.style.top=y+'px';
}
