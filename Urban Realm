<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>URBANISM — Thoughts on Urban Design</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --saffron:#E8621A;
  --turmeric:#D4920A;
  --terracotta:#B5451B;
  --indigo:#2C3E7A;
  --deep-indigo:#1A2550;
  --copper:#C47A2B;
  --cream:#F5ECD7;
  --warm-white:#FAF4E8;
  --parchment:#EDE0C4;
  --mud:#8B5E3C;
  --dark-mud:#4A2F1A;
  --leaf:#4A6741;
  --pale-gold:#F0D080;
  --text:#2A1A0E;
  --muted:#7A5C3C;
  --rule:#C8A87A;
}
html{scroll-behavior:smooth;}
body{background:var(--warm-white);color:var(--text);font-family:'Crimson Pro',serif;font-size:17px;line-height:1.7;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(circle at 1px 1px,rgba(180,90,30,0.06) 1px,transparent 0);background-size:28px 28px;pointer-events:none;z-index:0;}

/* PAGE SYSTEM */
.page{display:none;min-height:100vh;position:relative;z-index:1;}
.page.active{display:block;}

/* NAV */
nav{position:sticky;top:0;z-index:200;background:var(–dark-mud);border-bottom:3px solid var(–saffron);display:flex;align-items:stretch;justify-content:space-between;padding:0 2rem;}
.nav-brand{font-family:‘Playfair Display’,serif;font-size:1.5rem;font-weight:900;color:var(–pale-gold);text-decoration:none;padding:0.9rem 0;display:flex;align-items:center;gap:0.6rem;letter-spacing:0.06em;cursor:pointer;}
.nav-brand .bindi{width:10px;height:10px;background:var(–saffron);border-radius:50%;box-shadow:0 0 8px var(–saffron);}
.nav-links{display:flex;align-items:center;gap:0;}
.nav-links a{text-decoration:none;font-family:‘Crimson Pro’,serif;font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(245,236,215,0.7);padding:0.9rem 1.1rem;border-left:1px solid rgba(200,168,122,0.2);transition:all 0.2s;cursor:pointer;}
.nav-links a:hover,.nav-links a.active{color:var(–pale-gold);background:rgba(232,98,26,0.15);}

/* KATHIAWADI BORDER */
.kathi-border{height:12px;background:repeating-linear-gradient(90deg,var(–saffron) 0,var(–saffron) 8px,var(–turmeric) 8px,var(–turmeric) 16px,var(–terracotta) 16px,var(–terracotta) 24px,var(–indigo) 24px,var(–indigo) 32px,var(–copper) 32px,var(–copper) 40px);}
.kathi-border.thin{height:5px;}

.eyebrow{font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(–saffron);display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;}
.eyebrow::before{content:‘◆’;font-size:7px;}

/* ══ HOME ══ */
.hero{display:grid;grid-template-columns:1fr 1fr;min-height:88vh;border-bottom:2px solid var(–rule);}
.hero-left{background:var(–dark-mud);padding:4rem 3.5rem;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;}
.hero-left::before{content:’’;position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent 0,transparent 18px,rgba(232,98,26,0.04) 18px,rgba(232,98,26,0.04) 19px);}
.hero-vol{font-size:10px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(240,208,128,0.55);}
.hero-title{font-family:‘Playfair Display’,serif;font-size:clamp(4rem,7vw,8.5rem);font-weight:900;line-height:0.88;color:var(–pale-gold);position:relative;z-index:1;animation:slideUp 0.9s cubic-bezier(0.16,1,0.3,1) both;}
.hero-title em{font-style:italic;color:var(–saffron);display:block;}
.hero-tagline{font-family:‘Crimson Pro’,serif;font-style:italic;font-size:1.2rem;color:rgba(245,236,215,0.65);max-width:340px;line-height:1.55;position:relative;z-index:1;}
.hero-right{background:var(–parchment);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:2.5rem;}
.hero-city{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.hero-feat{position:relative;z-index:2;background:rgba(42,26,14,0.85);backdrop-filter:blur(2px);padding:1.4rem 1.8rem;border-left:4px solid var(–saffron);}
.hero-feat .tag{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(–saffron);display:block;margin-bottom:0.4rem;}
.hero-feat h2{font-family:‘Playfair Display’,serif;font-size:1.45rem;line-height:1.2;color:var(–pale-gold);}

.ticker-wrap{background:var(–saffron);overflow:hidden;padding:0.55rem 0;border-bottom:2px solid var(–terracotta);}
.ticker{display:inline-block;animation:ticker 32s linear infinite;white-space:nowrap;}
.ticker span{font-family:‘Playfair Display’,serif;font-size:1rem;letter-spacing:0.06em;color:var(–dark-mud);margin:0 1.5rem;}
.ticker span::before{content:‘❖’;margin-right:1.5rem;opacity:0.5;}

.topics-band{padding:1.2rem 2rem;display:flex;flex-wrap:wrap;align-items:center;gap:0.7rem;border-bottom:1px solid var(–rule);background:var(–cream);}
.lbl{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(–muted);}
.pill{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;padding:0.3rem 0.85rem;border:1.5px solid var(–mud);background:transparent;color:var(–mud);cursor:pointer;transition:all 0.15s;font-family:‘Crimson Pro’,serif;}
.pill:hover,.pill.active{background:var(–saffron);border-color:var(–saffron);color:var(–warm-white);}

.section-bar{padding:1.2rem 2rem;border-bottom:1px solid var(–rule);display:flex;align-items:baseline;gap:1rem;}
.section-bar h3{font-family:‘Playfair Display’,serif;font-size:1.3rem;font-weight:700;}
.section-bar span{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(–muted);}

.posts-grid{display:grid;grid-template-columns:repeat(3,1fr);}
.card{border-right:1px solid var(–rule);border-bottom:1px solid var(–rule);padding:2rem 1.8rem;transition:background 0.2s;cursor:pointer;display:flex;flex-direction:column;animation:fadeIn 0.5s ease both;}
.card:nth-child(3n){border-right:none;}
.card:hover{background:rgba(232,98,26,0.05);}
.card.wide{grid-column:span 2;display:grid;grid-template-columns:auto 1fr;gap:2rem;border-right:1px solid var(–rule);}
.pnum{font-family:‘Playfair Display’,serif;font-size:4rem;line-height:1;color:var(–parchment);font-weight:900;}
.pcat{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(–indigo);font-weight:700;margin-bottom:0.6rem;}
.ptitle{font-family:‘Playfair Display’,serif;font-size:1.2rem;line-height:1.25;margin-bottom:0.7rem;}
.card.wide .ptitle{font-size:1.7rem;}
.pex{font-size:14px;color:var(–muted);line-height:1.7;margin-bottom:1rem;flex:1;}
.pfoot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(–rule);padding-top:0.8rem;margin-top:auto;}
.pdate{font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(–muted);}
.plink{font-size:11px;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;color:var(–saffron);text-decoration:none;}
.plink::after{content:’ →’;}

.newslet{background:var(–dark-mud);color:var(–cream);padding:5rem 2rem;text-align:center;position:relative;overflow:hidden;border-top:3px solid var(–saffron);}
.newslet::before{content:’’;position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent 0,transparent 20px,rgba(232,98,26,0.03) 20px,rgba(232,98,26,0.03) 21px);}
.newslet h2{font-family:‘Playfair Display’,serif;font-size:2.8rem;font-weight:900;margin-bottom:0.5rem;color:var(–pale-gold);position:relative;}
.newslet p{color:rgba(245,236,215,0.55);font-style:italic;margin-bottom:2rem;position:relative;}
.sform{display:flex;justify-content:center;gap:0;max-width:420px;margin:0 auto;position:relative;}
.sform input{flex:1;padding:0.85rem 1.2rem;background:rgba(255,255,255,0.07);border:1.5px solid rgba(200,168,122,0.3);border-right:none;color:var(–cream);font-family:‘Crimson Pro’,serif;font-size:15px;outline:none;}
.sform input::placeholder{color:rgba(245,236,215,0.35);}
.sform button{padding:0.85rem 1.5rem;background:var(–saffron);color:var(–dark-mud);border:none;font-family:‘Playfair Display’,serif;font-size:1rem;font-weight:700;letter-spacing:0.1em;cursor:pointer;transition:background 0.2s;}
.sform button:hover{background:var(–turmeric);}

footer{border-top:2px solid var(–dark-mud);background:var(–dark-mud);padding:1.2rem 2rem;display:flex;justify-content:space-between;align-items:center;}
.fbrand{font-family:‘Playfair Display’,serif;font-size:1.3rem;color:var(–pale-gold);font-weight:900;}
.fcopy{font-size:11px;letter-spacing:0.1em;color:rgba(245,236,215,0.4);text-transform:uppercase;}

/* ══ BIO ══ */
.bio-top{background:var(–dark-mud);padding:5rem 2rem 0;position:relative;overflow:hidden;}
.bio-top::before{content:’’;position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0,transparent 24px,rgba(232,98,26,0.05) 24px,rgba(232,98,26,0.05) 25px);}
.bio-top-in{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:280px 1fr;gap:5rem;align-items:end;position:relative;z-index:1;}
.bio-portrait{width:260px;height:330px;background:var(–parchment);border:3px solid var(–copper);position:relative;box-shadow:8px 8px 0 var(–saffron);overflow:hidden;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;}
.bio-portrait-icon{font-size:5rem;opacity:0.25;color:var(–dark-mud);}
.bio-portrait-hint{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(–mud);}
.bio-name{font-family:‘Playfair Display’,serif;font-size:clamp(2.8rem,5vw,5rem);font-weight:900;line-height:0.95;color:var(–pale-gold);margin-bottom:1rem;padding-bottom:4rem;}
.bio-name em{color:var(–saffron);font-style:italic;}
.bio-tags{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.2rem;}
.bio-tag{font-size:11px;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;padding:0.25rem 0.75rem;border:1.5px solid rgba(200,168,122,0.4);color:rgba(245,236,215,0.7);}
.bio-intro{font-size:1.15rem;font-style:italic;color:rgba(245,236,215,0.7);line-height:1.65;max-width:520px;}

.bio-body{max-width:1100px;margin:0 auto;padding:4rem 2rem;display:grid;grid-template-columns:2fr 1fr;gap:4rem;}
.bio-body h3{font-family:‘Playfair Display’,serif;font-size:1.5rem;font-weight:700;color:var(–terracotta);margin:2.5rem 0 1rem;}
.bio-body h3:first-child{margin-top:0;}
.bio-body p{color:var(–text);font-size:1.05rem;margin-bottom:1.2rem;line-height:1.8;}
.bio-body strong{color:var(–dark-mud);}
.scard{background:var(–cream);border:1px solid var(–rule);padding:1.5rem;margin-bottom:1.5rem;position:relative;}
.scard::before{content:’’;position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(–saffron),var(–turmeric),var(–copper));}
.scard h4{font-family:‘Playfair Display’,serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(–dark-mud);margin-bottom:1rem;font-weight:700;}
.srow{display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px dotted var(–rule);}
.srow:last-child{border-bottom:none;}
.srl{font-size:13px;color:var(–muted);}
.srv{font-size:13px;font-weight:700;color:var(–dark-mud);}
.sint{display:flex;align-items:flex-start;gap:0.8rem;padding:0.6rem 0;border-bottom:1px dotted var(–rule);}
.sint:last-child{border-bottom:none;}
.sint-ico{font-size:1.1rem;flex-shrink:0;}
.sint-txt{font-size:13px;color:var(–muted);line-height:1.5;}

/* ══ PHOTOGRAPHY ══ */
.photo-hd{background:var(–dark-mud);padding:4rem 2rem 3rem;border-bottom:3px solid var(–saffron);position:relative;overflow:hidden;}
.photo-hd::before{content:’’;position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 40px,rgba(232,98,26,0.04) 40px,rgba(232,98,26,0.04) 41px);}
.photo-hd-in{max-width:900px;margin:0 auto;position:relative;z-index:1;}
.photo-hd h1{font-family:‘Playfair Display’,serif;font-size:clamp(3rem,6vw,6rem);font-weight:900;line-height:0.95;color:var(–pale-gold);margin-bottom:0.8rem;}
.photo-hd h1 em{color:var(–saffron);font-style:italic;}
.photo-hd p{font-style:italic;color:rgba(245,236,215,0.6);font-size:1.1rem;max-width:500px;}

.photo-fbar{padding:1rem 2rem;background:var(–cream);display:flex;flex-wrap:wrap;gap:0.6rem;align-items:center;border-bottom:1px solid var(–rule);}

.masonry{columns:3;column-gap:0;}
.photo-item{break-inside:avoid;position:relative;overflow:hidden;cursor:pointer;border:3px solid var(–warm-white);}
.photo-item:hover .photo-ov{opacity:1;}
.ph{width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.5rem;position:relative;}
.ph.tall{height:380px;}
.ph.med{height:260px;}
.ph.short{height:200px;}
.ph svg{position:absolute;inset:0;width:100%;height:100%;}
.ph-lbl{position:relative;z-index:1;font-family:‘Playfair Display’,serif;font-size:1rem;font-weight:700;color:var(–mud);text-align:center;padding:0 1rem;}
.ph-sub{position:relative;z-index:1;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(–muted);}
.photo-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(42,26,14,0.92) 0%,transparent 60%);opacity:0;transition:opacity 0.3s;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;}
.ov-tag{font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(–saffron);margin-bottom:0.3rem;}
.ov-city{font-family:‘Playfair Display’,serif;font-size:1.1rem;font-weight:700;color:var(–pale-gold);}

/* ══ TRAVEL ══ */
.travel-hd{background:linear-gradient(135deg,var(–dark-mud) 0%,var(–deep-indigo) 100%);padding:4rem 2rem 3rem;border-bottom:3px solid var(–turmeric);position:relative;overflow:hidden;}
.travel-hd-in{max-width:1000px;margin:0 auto;position:relative;z-index:1;}
.travel-hd h1{font-family:‘Playfair Display’,serif;font-size:clamp(3rem,6vw,6.5rem);font-weight:900;line-height:0.92;color:var(–pale-gold);margin-bottom:0.8rem;}
.travel-hd h1 span{color:var(–saffron);}
.travel-hd p{font-style:italic;color:rgba(245,236,215,0.6);font-size:1.1rem;}

.tstats{background:var(–dark-mud);border-bottom:2px solid rgba(200,168,122,0.2);display:grid;grid-template-columns:repeat(4,1fr);}
.tstat{padding:2rem;border-right:1px solid rgba(200,168,122,0.2);text-align:center;}
.tstat:last-child{border-right:none;}
.tstat-n{font-family:‘Playfair Display’,serif;font-size:3rem;font-weight:900;color:var(–saffron);line-height:1;margin-bottom:0.3rem;}
.tstat-l{font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(245,236,215,0.5);}

.tgrid{display:grid;grid-template-columns:repeat(2,1fr);border-bottom:1px solid var(–rule);}
.tcard{border-right:1px solid var(–rule);border-bottom:1px solid var(–rule);overflow:hidden;cursor:pointer;transition:transform 0.2s;}
.tcard:nth-child(2n){border-right:none;}
.tcard:hover{transform:translateY(-2px);}
.tcard-img{height:220px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;}
.tcard-body{padding:1.5rem;}
.tcard-ctry{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(–saffron);font-weight:700;margin-bottom:0.4rem;}
.tcard-city{font-family:‘Playfair Display’,serif;font-size:1.5rem;font-weight:700;margin-bottom:0.6rem;}
.tcard-desc{font-size:14px;color:var(–muted);line-height:1.65;margin-bottom:1rem;}
.tcard-tags{display:flex;flex-wrap:wrap;gap:0.4rem;}
.ttag{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;padding:0.2rem 0.6rem;background:var(–parchment);color:var(–mud);border:1px solid var(–rule);}
.tcard.feat{grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;border-right:none;}
.tcard.feat .tcard-img{height:100%;min-height:300px;}
.tcard.feat .tcard-city{font-size:2rem;}

/* ══ WORLD MAP ══ */
.map-hd{background:var(–dark-mud);padding:3rem 2rem;border-bottom:3px solid var(–turmeric);}
.map-hd-in{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:flex-end;}
.map-hd h1{font-family:‘Playfair Display’,serif;font-size:clamp(2.5rem,5vw,5rem);font-weight:900;line-height:0.95;color:var(–pale-gold);}
.map-hd h1 em{color:var(–saffron);font-style:italic;}
.map-hd-sub{font-style:italic;color:rgba(245,236,215,0.5);font-size:1rem;max-width:300px;text-align:right;}

.map-wrap{background:var(–deep-indigo);padding:2rem;position:relative;min-height:520px;overflow:hidden;}

.map-legend{background:var(–dark-mud);border-top:1px solid rgba(200,168,122,0.2);padding:1.2rem 2rem;display:flex;gap:2rem;align-items:center;flex-wrap:wrap;}
.leg-item{display:flex;align-items:center;gap:0.5rem;}
.leg-dot{width:10px;height:10px;border-radius:50%;border:2px solid var(–pale-gold);}
.leg-lbl{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(245,236,215,0.6);}

.cities-data{max-width:1100px;margin:0 auto;padding:3rem 2rem;}
.cities-data h2{font-family:‘Playfair Display’,serif;font-size:2rem;font-weight:700;color:var(–dark-mud);margin-bottom:2rem;}
table{width:100%;border-collapse:collapse;}
th{background:var(–dark-mud);color:var(–pale-gold);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;padding:0.9rem 1.2rem;text-align:left;font-family:‘Crimson Pro’,serif;font-weight:600;}
td{padding:0.9rem 1.2rem;border-bottom:1px solid var(–rule);font-size:14px;vertical-align:middle;}
tr:hover td{background:rgba(232,98,26,0.04);}
.cf{font-size:1.3rem;margin-right:0.4rem;}
.cn{font-family:‘Playfair Display’,serif;font-size:1rem;font-weight:700;}
.fbar{height:6px;background:var(–parchment);border-radius:3px;overflow:hidden;width:120px;}
.ffill{height:100%;background:linear-gradient(90deg,var(–saffron),var(–turmeric));border-radius:3px;}
.rbadge{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;padding:0.2rem 0.6rem;font-weight:700;}
.ri{background:rgba(232,98,26,0.15);color:var(–saffron);}
.re{background:rgba(196,122,43,0.15);color:var(–copper);}
.rs{background:rgba(74,103,65,0.15);color:var(–leaf);}
.rm{background:rgba(181,69,27,0.15);color:var(–terracotta);}

/* ANIMATIONS */
@keyframes slideUp{from{opacity:0;transform:translateY(40px);}to{opacity:1;transform:translateY(0);}}
@keyframes fadeIn{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
@keyframes ticker{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes pulse{0%{r:6;}50%{r:14;opacity:0.1;}100%{r:6;opacity:0;}}

/* RESPONSIVE */
@media(max-width:900px){
.hero{grid-template-columns:1fr;min-height:auto;}
.hero-right{height:300px;}
.posts-grid{grid-template-columns:1fr 1fr;}
.card.wide{grid-column:span 2;grid-template-columns:1fr;}
.bio-top-in{grid-template-columns:1fr;gap:2rem;}
.bio-body{grid-template-columns:1fr;}
.masonry{columns:2;}
.tgrid{grid-template-columns:1fr;}
.tcard.feat{grid-column:span 1;grid-template-columns:1fr;}
.tcard.feat .tcard-img{height:220px;}
.tstats{grid-template-columns:repeat(2,1fr);}
.map-hd-in{flex-direction:column;gap:1rem;}
.map-hd-sub{text-align:left;}
}
@media(max-width:600px){
.posts-grid,.tgrid{grid-template-columns:1fr;}
.card.wide,.tcard.feat{grid-column:span 1;}
.masonry{columns:1;}
.nav-links a{padding:0.9rem 0.6rem;font-size:11px;letter-spacing:0.08em;}
.tstats{grid-template-columns:repeat(2,1fr);}
}
</style>

</head>
<body>

<nav>
  <div class="nav-brand" onclick="showPage('home')"><span class="bindi"></span>URBANISM</div>
  <div class="nav-links">
    <a onclick="showPage('home')" class="active" id="nav-home">Essays</a>
    <a onclick="showPage('bio')" id="nav-bio">About Me</a>
